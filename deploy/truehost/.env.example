APP_ENV=prod
LOG_LEVEL=INFO
UVICORN_WORKERS=2

# Core
DATABASE_URL=
DATABASE_URL_SYNC=
REDIS_URL=
SECRET_KEY=
PHONE_HASH_PEPPER=
ADMIN_API_TOKEN=
JWT_SECRET=
ADMIN_CORS_ORIGINS=

# LLM
LLM_PROVIDER=openai
LLM_FALLBACK_PROVIDERS=groq
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_REASONING_EFFORT=low
OPENAI_USE_RESPONSES_API=true
OPENAI_STORE_RESPONSES=true
EMBED_PROVIDER=openai
OPENAI_EMBED_MODEL=text-embedding-3-large
OPENAI_EMBED_DIMENSIONS=768

# WhatsApp
WHATSAPP_PROVIDER=meta
META_WA_PHONE_NUMBER_ID=
META_WA_ACCESS_TOKEN=
META_WA_VERIFY_TOKEN=
META_WA_APP_SECRET=

# Payments
PAYMENT_PROVIDER=intasend
INTASEND_API_TOKEN=
INTASEND_PUBLISHABLE_KEY=
INTASEND_TEST_MODE=false
INTASEND_WEBHOOK_SECRET=
INTASEND_BASE_URL=https://payment.intasend.com/api/v1

# Admin / frontend origins
PORTAL_BASE_URL=https://geneat.lesnarai.co.ke
ADMIN_BASE_URL=https://admin.lesnarai.co.ke

# Storage / observability
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
SENTRY_DSN=
