# ── App ───────────────────────────────────────────────────────────────
APP_ENV=dev
APP_NAME=omnichannel-ai
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
EXPECTED_RENDER_REGION=
DATABASE_REGION=
REDIS_REGION=
SECRET_KEY=change-me-to-a-long-random-string
PHONE_HASH_PEPPER=change-me-too

# ── Database ──────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://omni:omni@localhost:5432/omni
# Sync URL used by Alembic only:
DATABASE_URL_SYNC=postgresql+psycopg://omni:omni@localhost:5432/omni
# Render prod: API, Postgres, and Key Value must be in the same region.
# Current Hazina target is frankfurt for Kenya/Europe-facing traffic.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ── Redis ─────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── OpenAI / LLM ──────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5.4-mini
OPENAI_REASONING_EFFORT=low
OPENAI_USE_RESPONSES_API=true
OPENAI_STORE_RESPONSES=true
OPENAI_EMBED_MODEL=text-embedding-3-large
OPENAI_EMBED_DIMENSIONS=768
# Embedding provider: "openai" uses text-embedding-3-large at 768 dims; "local" uses Ollama nomic 768 dims.
EMBED_PROVIDER=openai
LLM_PROVIDER=openai
LLM_FALLBACK_PROVIDERS=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FALLBACK_MODEL=llama-3.1-8b-instant
# Local Ollama (LLM_PROVIDER=local): base model for café tenants
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=llama3.1
# Fine-tuned Hazina concierge (open-ended LangGraph only; menus stay deterministic)
HAZINA_LLM_MODEL=hazina-concierge

# ── ElevenLabs (Phase 5) ──────────────────────────────────────────────
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL=eleven_turbo_v2_5

# ── WhatsApp (Phase 3) ────────────────────────────────────────────────
WHATSAPP_PROVIDER=meta              # meta | africastalking | twilio
WHATSAPP_REENGAGEMENT_TEMPLATE=hello_world
WHATSAPP_REENGAGEMENT_TEMPLATE_LANG=en_US
META_WA_PHONE_NUMBER_ID=
META_WA_ACCESS_TOKEN=
META_WA_VERIFY_TOKEN=
META_WA_APP_SECRET=

# ── Africa's Talking (SMS / Voice fallback) ───────────────────────────
AT_USERNAME=sandbox
AT_API_KEY=
AT_SHORTCODE=
AT_BASE_URL=https://api.sandbox.africastalking.com

# ── Twilio (Phase 5) ──────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── M-Pesa Daraja (Phase 4) ───────────────────────────────────────────
MPESA_ENV=sandbox                    # sandbox | production
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://your-domain/payments/callback

# ── Google Calendar (Phase 6) ─────────────────────────────────────────
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_CALENDAR_ID=primary

# ── Rate limits (overridable) ─────────────────────────────────────────
RL_INBOUND_PER_MIN=120
RL_WA_OUTBOUND_PER_SEC=50
RL_MPESA_STK_PER_MSISDN_SEC=30

# ── Human escalation ──────────────────────────────────────────────────
OWNER_ALERT_PHONE=+254700000000
AI_MAX_FAILED_TURNS=2

# ── Multi-tenant routing ───────────────────────────────────────────────
# Default tenant when webhook cannot resolve by Meta phone_number_id.
# Production default tenant (Hazina Nomads). Lily Pond stays for café demos via DEMO_BUSINESS_SLUG.
DEFAULT_BUSINESS_SLUG=hazina-nomads
# Hazina owns the configured Meta number in production; set false only for a dedicated café deployment.
HAZINA_CLAIMS_META_PHONE=true
# Demo fast-path (KES 10 espresso) — only fires for this slug.
DEMO_BUSINESS_SLUG=lily-pond-cafe

# ── CORS / Public URLs ────────────────────────────────────────────────
# Comma-separated list of origins allowed to call the API with credentials.
# Use "*" only in dev; in prod, list the exact hostnames.
ADMIN_CORS_ORIGINS=https://geneat.lesnarai.co.ke,https://hazina.lesnarai.co.ke,https://www.lesnarai.co.ke,https://lesnarai.co.ke
# Public-facing base URLs (used in outbound links, webhooks, M-Pesa callbacks).
PUBLIC_PORTAL_URL=https://geneat.lesnarai.co.ke
PUBLIC_API_URL=https://api.lesnarai.co.ke

# ── Hazina Nomads portal (hazina-portal/) ─────────────────────────────
# Standalone site — separate from Gen-Eat. See docs/HAZINA_NOMADS.md.
PUBLIC_HAZINA_PORTAL_URL=https://hazina.lesnarai.co.ke
NEXT_PUBLIC_HAZINA_WHATSAPP=15556578220
NEXT_PUBLIC_HAZINA_PHONE=+15556578220
# Private partner portal (/partners/login) — not linked from public nav
PARTNER_PORTAL_EMAIL=
PARTNER_PORTAL_PASSWORD=
PARTNER_REFERRAL_CODE=REF-HOST-001

# ── Payments (Hazina: hybrid routing) ─────────────────────────────────
# KES M-Pesa STK → IntaSend; USD cards → Paystack (auto-routed by currency).
PAYMENT_PROVIDER=intasend
PAYMENT_SIMULATOR=false
INTASEND_API_TOKEN=
INTASEND_PUBLISHABLE_KEY=
INTASEND_TEST_MODE=true
INTASEND_WEBHOOK_SECRET=
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
